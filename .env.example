# ---------------------------------------------------------------------------
# BIMA DuctDesigner - environment settings
#
# Copy this file to ".env" for local testing.
# On Vercel you do NOT need this file: you enter the same values in the
# Vercel dashboard under  Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Database location. If you leave this empty on Vercel, the app uses a
# temporary file in /tmp and creates everything by itself (demo mode).
# DATABASE_URL=file:/tmp/ductdesigner.db

# Admin panel login (page /?admin=1). Change these two values before sharing
# the demo link publicly!
ADMIN_PASSWORD=admin123
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Optional: WooCommerce product sync (set later in the Vercel dashboard) ---
# WOO_STORE_URL=https://your-shop.com
# WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: dealer sub-domains (needs wildcard DNS *.your-domain.com) ---
# ROOT_DOMAIN=duct.your-domain.com
